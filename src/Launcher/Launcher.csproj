<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained so target machines need no .NET runtime; trimmed to keep the MSI small. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the exe be built and published from macOS and Linux as well as Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ThoriumVoiceBridge</AssemblyName>
    <RootNamespace>Nota.ThoriumVoiceBridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\App\KB_icon.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <Version>1.3.0</Version>
    <Product>Tilføj stemmer til Thorium</Product>
    <AssemblyTitle>Tilføj stemmer til Thorium</AssemblyTitle>
    <Company>Det Kgl. Bibliotek – Nota-service</Company>
    <Copyright>© Det Kgl. Bibliotek</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

</Project>
